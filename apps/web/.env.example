DATABASE_URL=

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

TRANSCRIPT_API_KEY=

# YouTube Data API v3 key from your own GCP project (APIs & Services
# → Credentials). When set, it becomes the primary source for YouTube
# channel/video metadata — scrape, RSS, and TranscriptAPI stay as
# fallbacks. Optional: leave empty to use only the fallback chain.
YOUTUBE_API_KEY=

# JustOneAPI — third-party wrapper around Bilibili used for channel
# imports and refresh. Avoids direct Bilibili IP-reputation and
# risk-control issues. Sign up at https://justoneapi.com to get a
# token. Used by BilibiliPlatform.fetchChannelSnapshot.
JUSTONEAPI_TOKEN=

# Vercel AI Gateway — used for LLM-powered article generation.
# Create a key at https://vercel.com/dashboard/ai/api-keys
# Not required when deployed on Vercel (OIDC is used automatically).
AI_GATEWAY_API_KEY=

# Native Google Gemini API key (https://aistudio.google.com/apikey).
# Used only by scripts/generateFromVideo.ts to call Gemini's video
# understanding directly (fileData/YouTube URI) instead of through the
# AI Gateway. Not used by the app runtime.
GEMINI_API_KEY=

CRON_SECRET=
